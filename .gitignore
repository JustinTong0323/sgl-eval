# Vendored prepare.py scripts download/extract data next to themselves on
# first use; we move outputs to ~/.cache/sgl_eval/, but guard against partial
# moves and preserve cleanliness of the vendored tree.
sgl_eval/_vendored/nemo_skills/dataset/gsm8k/test.jsonl
sgl_eval/_vendored/nemo_skills/dataset/gsm8k/original_*.jsonl
sgl_eval/_vendored/nemo_skills/dataset/mmlu/test.jsonl
sgl_eval/_vendored/nemo_skills/dataset/mmlu/data.tar
sgl_eval/_vendored/nemo_skills/dataset/gpqa/*.jsonl

# Local preset configs. Contain real cluster paths / endpoints, so never
# committed. Staged in this folder so rdev sync / lsync ferries them to the
# remote machine; from there manually `cp presets/*.yaml ~/.sgl_eval/presets/`.
/presets/
